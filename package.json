{
  "name": "aura-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "test:unit": "vitest run",
    "test:a11y": "node --test --experimental-strip-types tests/a11y/**/*.test.ts",
    "test:e2e": "playwright test",
    "perf:test": "playwright test -c playwright.perf.config.ts",
    "perf:compare": "node tests/perf/compare-results.mjs",
    "perf:p75": "node tests/perf/compare-p75.mjs",
    "perf:route-js": "node tests/perf/route-js-budget.mjs",
    "perf:lighthouse": "LIGHTHOUSE_BIN=${LIGHTHOUSE_BIN:?Set LIGHTHOUSE_BIN to a pinned Lighthouse binary path} node tests/perf/lighthouse.mjs",
    "perf:lighthouse:report": "node tests/perf/lighthouse-report.mjs",
    "admin:dev": "npm run dev --prefix apps/admin",
    "admin:build": "npm run build --prefix apps/admin",
    "admin:start": "npm run start --prefix apps/admin",
    "admin:lint": "npm run lint --prefix apps/admin"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-intl": "^4.9.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.3.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "axe-core": "^4.11.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
